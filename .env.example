# 이 파일은 "이름만" 적어둔 예시입니다. 실제 값은 .env 에 넣으세요(.env 는 git 에 안 올라감).

# --- 데이터베이스 (사내에서 받은 연결 문자열) ---
# 예: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- 사내 Supabase Storage (사진 저장/조회) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EMAIL=
SUPABASE_PASSWORD=
SUPABASE_BUCKET=

# --- 관리자 페이지 로그인 비밀번호 ---
ADMIN_PASSWORD=

# --- Slack 알림 웹훅 (선택) ---
SLACK_WEBHOOK_URL=
